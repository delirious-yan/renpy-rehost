<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rehost</AssemblyName>
    <RootNamespace>RenpyRehost.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.0.1</Version>
    <Product>Ren'Py Rehost</Product>
    <AssemblyTitle>Ren'Py Rehost — local Ren'Py to web converter</AssemblyTitle>
    <RuntimeIdentifier Condition="'$(PublishSingleFile)' == 'true'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RenpyRehost.Core\RenpyRehost.Core.csproj" />
  </ItemGroup>

</Project>
